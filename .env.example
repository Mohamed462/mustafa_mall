# ========================================================
# مول المصطفى (Al Mostafa Mall) - إعدادات البيئة السحابية
# ========================================================
# عند تفعيل هذين المتغيرين:
# 1. سيتم تفعيل المزامنة السحابية الفورية لقاعدة البيانات بدلاً من التخزين المحلي المعزول.
# 2. ستظهر نفس المنتجات والطلبات والتصنيفات في Chrome و Edge والموبايل وجميع الأجهزة.
# 3. يتم تفعيل زر تسجيل الدخول التلقائي بحساب Google (OAuth).

# 1. عنوان مشروع Supabase الخاص بك:
# تجده في: https://supabase.com/dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. المفتاح العام المجهول (anon public key):
# تجده في: Project Settings -> API -> Project API keys -> anon public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ملاحظة:
# لتفعيل الدخول بحساب Google (One-Click Google Login):
# 1. افتح Supabase Dashboard -> Authentication -> Providers -> Google.
# 2. فعّل Google وضع Client ID و Client Secret من Google Cloud Console (APIs & Services -> Credentials).
# 3. أضف الرابط التالي في Google Cloud Console Authorized redirect URIs:
#    https://<your-project-ref>.supabase.co/auth/v1/callback
